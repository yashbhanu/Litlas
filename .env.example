# Copy to .env.local and fill in. Local Supabase values come from `pnpm db:start` / `pnpm exec supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Sent to Open Library, Wikidata and Photon. Include a contact address.
APP_USER_AGENT="LiteraryWorldMap/0.1 (contact: you@example.com)"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show "Continue with Google" on /login (requires Google provider set up in Supabase).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# Optional: Mailpit URL for e2e tests (local Supabase default shown).
# MAILPIT_URL=http://127.0.0.1:54324
